<Window x:Class="SimpleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleApp"
        mc:Ignorable="d"
        Title="Калькулятор" Height="350" Width="500" WindowStyle="ThreeDBorderWindow" Background="White">
    <Grid x:Name="MainRoot" Background="#FFD07F7F">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" x:Name="textLabel"/>
        <Button Grid.Column="0" Grid.Row="1" Background="#FFCEC690">1</Button>
        <Button Grid.Column="1" Grid.Row="1" Background="#FFCEC690">2</Button>
        <Button Grid.Column="2" Grid.Row="1" Background="#FFCEC690">3</Button>
        <Button Grid.Column="0" Grid.Row="2" Background="#FFCEC690">4</Button>
        <Button Grid.Column="1" Grid.Row="2" Background="#FFCEC690">5</Button>
        <Button Grid.Column="2" Grid.Row="2" Background="#FFCEC690">6</Button>
        <Button Grid.Column="0" Grid.Row="3" Background="#FFCEC690">7</Button>
        <Button Grid.Column="1" Grid.Row="3" Background="#FFCEC690">8</Button>
        <Button Grid.Column="2" Grid.Row="3" Background="#FFCEC690">9</Button>
        <Button Grid.Column="0" Grid.Row="4" Background="#FFCEC690">0</Button>
        <Button Grid.Column="3" Grid.Row="1" Background="#FFCEC690">+</Button>
        <Button Grid.Column="3" Grid.Row="2" Background="#FFCEC690">-</Button>
        <Button Grid.Column="3" Grid.Row="3" Background="#FFCEC690">*</Button>
        <Button Grid.Column="3" Grid.Row="4" Background="#FFCEC690">/</Button>
        <Button Grid.Column="1" Grid.Row="4" Background="#FFCEC690">=</Button>
        <Button Grid.Column="2" Grid.Row="4" Background="#FFCEC690">AC</Button>
    </Grid>
</Window>
